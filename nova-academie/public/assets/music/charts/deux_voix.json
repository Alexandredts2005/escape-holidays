1522,"dis"],[53.4783,"pu"],[54.7826,"tés"],[55.1087,"pour"],[56.087,"rien"]]},{"t0":57.3913,"t1":62.6087,"text":"Pour une note pour un mot","syl":[[57.3913,"Pour"],[57.7174,"u"],[58.0435,"ne"],[58.3696,"no"],[58.6957,"te"],[59.0217,"pour"],[59.6739,"un"],[60.6522,"mot"]]},{"t0":62.6087,"t1":67.8261,"text":"Mais quand tu me prends la main","syl":[[62.6087,"Mais"],[63.913,"quand"],[64.2391,"tu"],[64.5652,"me"],[65.2174,"prends"],[65.5435,"la"],[66.5217,"main"]]},{"t0":67.8261,"t1":73.0435,"text":"Tout devient plus doux plus beau","syl":[[67.8261,"Tout"],[68.4783,"de"],[69.1304,"vient"],[69.7826,"plus"],[70.4348,"doux"],[70.7609,"plus"],[71.087,"beau"]]},{"t0":73.0435,"t1":78.2609,"text":"Deux voix un seul cœur","syl":[[73.0435,"Deux"],[73.3696,"voix"],[74.3478,"un"],[75.9783,"seul"],[76.3043,"cœur"]]},{"t0":78.2609,"t1":83.4783,"text":"Deux chemins la même couleur","syl":[[78.2609,"Deux"],[79.2391,"che"],[79.5652,"mins"],[80.2174,"la"],[80.8696,"mê"],[81.5217,"me"],[81.8478,"cou"],[82.1739,"leur"]]},{"t0":83.4783,"t1":88.6957,"text":"Deux voix pour ce soir","syl":[[83.4783,"Deux"],[84.1304,"voix"],[85.1087,"pour"],[85.7609,"ce"],[87.3913,"soir"]]},{"t0":88.6957,"t1":93.913,"text":"Et le monde veut y croire","syl":[[88.6957,"Et"],[89.0217,"le"],[89.3478,"mon"],[89.6739,"de"],[90.6522,"veut"],[91.3043,"y"],[91.6304,"croi"],[91.9565,"re"]]},{"t0":93.913,"t1":99.1304,"text":"Ta voix dans la mienne","syl":[[94.2391,"Ta"],[94.5652,"voix"],[94.8913,"dans"],[96.1957,"la"],[97.5,"mien"],[97.8261,"ne"]]},{"t0":99.1304,"t1":104.3478,"text":"Que la nuit nous tienne","syl":[[99.1304,"Que"],[99.7826,"la"],[100.4348,"nuit"],[101.413,"nous"],[102.0652,"tien"],[103.0435,"ne"]]},{"t0":104.3478,"t1":109.5652,"text":"Deux voix un seul cœur","syl":[[104.3478,"Deux"],[104.6739,"voix"],[105.6522,"un"],[107.2826,"seul"],[107.6087,"cœur"]]},{"t0":109.5652,"t1":114.7826,"text":"Deux chemins la même couleur","syl":[[109.5652,"Deux"],[110.5435,"che"],[110.8696,"mins"],[111.5217,"la"],[112.1739,"